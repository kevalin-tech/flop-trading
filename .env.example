# Copy to .env and adjust. Paths are relative to the app directory unless absolute.
FLOP_ROSTER=roster.json
FLOP_KEYS_DIR=keys
FLOP_STATE_DIR=state

# Start with a few agents, then raise to 0 (= the whole roster)
FLOP_MAX_AGENTS=0

# technocore.chat allows 300 writes and 600 reads per minute per IP; leave room for anything else on this server
FLOP_WRITES_PER_MINUTE=100
FLOP_READS_PER_MINUTE=300

# Each agent posts one offer about every this many minutes (strong agents 2x, medium 1.5x as often)
FLOP_AGENT_INTERVAL_MINUTES=10
FLOP_QTY_MIN=0.1
FLOP_QTY_MAX=1.0
FLOP_MAX_POSITION=5
# Our offers are this much better than the market for whoever takes them (0.01 = 1%)
FLOP_OFFER_EDGE=0.01
FLOP_OFFER_SWEEPS=2
# We accept other agents' offers priced up to this much worse than the market
FLOP_TAKE_SLIP=0.002
FLOP_MAX_TAKE_QTY=3
FLOP_TAKES_PER_MINUTE=20
